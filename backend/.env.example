DATABASE_URL=postgresql+psycopg://hackalem:password@127.0.0.1:5432/hackalem
STORAGE_DIR=C:/hackalem-data
MAX_UPLOAD_MB=200
# Replace with the IPv4 address of the AI laptop (example only).
AI_BASE_URL=http://192.168.1.50:8000
# http = call the AI service; mock = local canned result; real = alias for http.
AI_MODE=http
# Must match INTERNAL_TOKEN in ai-service/.env. Empty on both sides disables it.
AI_INTERNAL_TOKEN=
# CPU inference can take several minutes.
AI_TIMEOUT_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:5173
